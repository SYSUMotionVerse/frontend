# The API domain must be configured as a WeChat request legal domain.
VITE_API_BASE_URL=https://api.example.com/api

# Upload models/pose with `pnpm pose:cos:upload`, then use the public HTTPS
# COS CDN origin. Keep the version in both values aligned.
VITE_POSE_MODEL_VERSION=blazepose-lite-v1
VITE_POSE_MODEL_BASE_URL=https://cdn.sysusports.cn/pose/blazepose-lite-v1
