# The API domain must be configured as a WeChat request legal domain.
VITE_API_BASE_URL=https://api.example.com/api

# Upload models/pose with `pnpm pose:oss:upload`, then use the public HTTPS
# OSS or CDN origin. Keep the version in both values aligned.
VITE_POSE_MODEL_VERSION=blazepose-lite-v1
VITE_POSE_MODEL_BASE_URL=https://models.example.com/pose/blazepose-lite-v1
