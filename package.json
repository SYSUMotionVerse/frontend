{
  "name": "sport-snack-student-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "uni -p mp-weixin",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:tunnel": "node scripts/pose-model-tunnel.mjs dev",
    "build": "uni build -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin:production": "node scripts/build-production.mjs",
    "build:mp-weixin-cf": "node scripts/pose-model-tunnel.mjs build",
    "pose:cos:upload": "node scripts/upload-pose-models-cos.mjs",
    "serve:pose-models": "python3 -m http.server 8765 --directory models/pose",
    "pose:tunnel:start": "node scripts/pose-model-tunnel.mjs start",
    "pose:tunnel:stop": "node scripts/pose-model-tunnel.mjs stop",
    "pose:tunnel:status": "node scripts/pose-model-tunnel.mjs status",
    "test": "vitest run"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5000420260318001",
    "@dcloudio/uni-components": "3.0.0-5000420260318001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5000420260318001",
    "@mediapipe/pose": "^0.5.1675469404",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "abab": "^2.0.6",
    "long": "^5.3.2",
    "seedrandom": "^3.0.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.28",
    "@dcloudio/vite-plugin-uni": "3.0.0-5000420260318001",
    "@furinalu/unocss-preset-weapp": "^0.6.31",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "^2.4.6",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "unocss": "^66.5.4",
    "vite": "5.2.8",
    "vitest": "^3.0.7",
    "vue-tsc": "^2.2.0"
  }
